index=security sourcetype=linux_secure
"Failed password"
| rex field=_raw "Failed password for (?:(?<invalid_user>invalid user) )?(?<user>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3}) port (?<src_port>\d+)"
| eval account_category=if(isnotnull(invalid_user),"invalid","recognized_or_existing")
| stats
    count AS failed_attempts
    count(eval(account_category="invalid")) AS invalid_account_attempts
    count(eval(account_category="recognized_or_existing")) AS recognized_account_attempts
    dc(user) AS unique_accounts
    dc(host) AS targeted_hosts
    values(host) AS hosts
    values(user) AS targeted_users
    earliest(_time) AS first_seen_epoch
    latest(_time) AS last_seen_epoch
  by src_ip
| eval invalid_pct=round((invalid_account_attempts/failed_attempts)*100,2)
| eval duration_hours=round((last_seen_epoch-first_seen_epoch)/3600,2)
| eval first_seen=strftime(first_seen_epoch,"%Y-%m-%d %H:%M:%S")
| eval last_seen=strftime(last_seen_epoch,"%Y-%m-%d %H:%M:%S")
| sort - failed_attempts
| table src_ip failed_attempts unique_accounts targeted_hosts invalid_account_attempts recognized_account_attempts invalid_pct duration_hours hosts targeted_users first_seen last_seen
